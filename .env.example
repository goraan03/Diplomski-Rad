# ── Zajednicko ──────────────────────────────────────────────
JWT_SECRET=change-me-super-secret-shared-across-services
NODE_ENV=development

# ── MySQL (jedan server, sema po servisu) ───────────────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_ROOT_PASSWORD=root
MYSQL_PORT=3307

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://fittrack:fittrack_dev_pass@127.0.0.1:5672
RABBITMQ_USER=fittrack
RABBITMQ_PASSWORD=fittrack_dev_pass
RABBITMQ_EXCHANGE=fittrack.events

# ── Gateway ─────────────────────────────────────────────────
GATEWAY_PORT=4000
CORS_ORIGIN=http://localhost:5173
IDENTITY_URL=http://127.0.0.1:4001
COACHING_URL=http://127.0.0.1:4002
SCHEDULING_URL=http://127.0.0.1:4003
AUDIT_URL=http://127.0.0.1:4004
GATEWAY_PORT=4000
CORS_ORIGIN=http://localhost:5173
# Strangler fallback na stari monolit za jos-nemigrirane rute (opciono)
# LEGACY_URL=http://legacy:4000

# ── Identity ────────────────────────────────────────────────
IDENTITY_PORT=4001
IDENTITY_DB_HOST=127.0.0.1
IDENTITY_DB_PORT=3307
IDENTITY_DB_NAME=fittrack_identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_pass
JWT_EXPIRES_IN=1d
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
ADMIN_EMAIL=admin@fittrack.local
ADMIN_PASSWORD=change-this-admin-password

# ── Coaching ────────────────────────────────────────────────
COACHING_PORT=4002
COACHING_DB_HOST=127.0.0.1
COACHING_DB_PORT=3307
COACHING_DB_NAME=fittrack_coaching
COACHING_DB_USER=coaching_user
COACHING_DB_PASSWORD=coaching_pass

# ── Scheduling ──────────────────────────────────────────────
SCHEDULING_PORT=4003
SCHEDULING_DB_HOST=127.0.0.1
SCHEDULING_DB_PORT=3307
SCHEDULING_DB_NAME=fittrack_scheduling
SCHEDULING_DB_USER=scheduling_user
SCHEDULING_DB_PASSWORD=scheduling_pass
BOOKING_WINDOW_MIN=60

# ── Audit ───────────────────────────────────────────────────
AUDIT_PORT=4004
AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_PORT=3307
AUDIT_DB_NAME=fittrack_audit
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=audit_pass

# ── Notification ────────────────────────────────────────────
NOTIFICATION_PORT=4005