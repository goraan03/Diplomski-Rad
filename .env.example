# ── Zajednicko ──────────────────────────────────────────────
JWT_SECRET=change-me-super-secret-shared-across-services
NODE_ENV=development

# ── MySQL (jedan server, sema po servisu) ───────────────────
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=root

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=fittrack.events

# ── Gateway ─────────────────────────────────────────────────
GATEWAY_PORT=4000
CORS_ORIGIN=http://localhost:5173
IDENTITY_URL=http://identity:4001
# Strangler fallback na stari monolit za jos-nemigrirane rute (opciono)
# LEGACY_URL=http://legacy:4000